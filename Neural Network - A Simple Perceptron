    {
      "cell_type": "code",
      "source": [
        "\n",
        "import numpy as np\n",
        "\n",
        "# Step 1: Define the AND gate dataset\n",
        "X = np.array([[0,0],\n",
        "              [0,1],\n",
        "              [1,0],\n",
        "              [1,1]])      # Input\n",
        "y = np.array([[0],\n",
        "              [0],\n",
        "              [0],\n",
        "              [1]])        # Expected output\n",
        "\n",
        "# Step 2: Initialize weights and bias\n",
        "weights = np.random.rand(2, 1)   # two inputs, one output\n",
        "bias = np.random.rand(1)\n",
        "learning_rate = 0.1\n",
        "\n",
        "# Step 3: Define activation function (Step Function)\n",
        "def step_function(x):\n",
        "    return np.where(x >= 0, 1, 0)\n",
        "\n",
        "# Step 4: Training the perceptron\n",
        "epochs = 10\n",
        "for epoch in range(epochs):\n",
        "    # Linear combination\n",
        "    z = np.dot(X, weights) + bias\n",
        "    # Activation\n",
        "    y_pred = step_function(z)\n",
        "\n",
        "    # Calculate error\n",
        "    error = y - y_pred\n",
        "\n",
        "    # Weight and bias update\n",
        "    weights += learning_rate * np.dot(X.T, error)\n",
        "    bias += learning_rate * np.sum(error)\n",
        "\n",
        "    print(f\"Epoch {epoch+1}/{epochs}\")\n",
        "    print(f\"Weights: {weights.T}, Bias: {bias}, Error: {np.sum(error)}\\n\")\n",
        "\n",
        "# Step 5: Final output after training\n",
        "print(\"Final prediction after training:\")\n",
        "print(step_function(np.dot(X, weights) + bias))\n",
        "\n"
      ],
